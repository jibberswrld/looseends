# Postgres (Neon). Provisioned through the Vercel Marketplace; `vercel env pull .env.local` fills these.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 32+ random characters. Encrypts stored publik keys and users' own AI keys.
APP_SECRET=

# publik app token (pat_...) for the hosted server. Minted with publik's device flow (skills/api.md step 2).
PUBLIK_APP_TOKEN=

# Development only
# PUBLIK_API_KEY=          # use one publik key for everything
# PUBLIK_ORIGIN=http://localhost:4555   # point at scripts/mock-publik.mjs
