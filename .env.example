# LooseEnds runs locally and needs no configuration: data lives in your app-data folder,
# the publik app token ships in publik-app-token.txt, and an encryption secret is created on first run.

# Development overrides (optional)
# PUBLIK_API_KEY=                        # use one publik key instead of Sign in with publik
# PUBLIK_ORIGIN=http://localhost:4555     # point at scripts/mock-publik.mjs
# LOOSEENDS_DATA_DIR=/tmp/looseends       # keep test data out of your real app-data folder
# CONNECTOR_ORIGIN=http://localhost:4666  # point Gmail / Calendar at scripts/mock-connector.mjs

# Hosted connector deployment only (never on a user's computer): turns on /api/connector/*
# COMPOSIO_API_KEY=
