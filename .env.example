# Hosted deployment
DATABASE_URL=
APP_SECRET=                    # 32+ characters; keep stable to decrypt stored keys
COMPOSIO_API_KEY=
PUBLIK_APP_TOKEN=              # public app token; publik-app-token.txt is also supported

# Local development (optional; unset DATABASE_URL to use PGlite)
# PUBLIK_ORIGIN=http://localhost:4555
# LOOSEENDS_DATA_DIR=/tmp/looseends
# CONNECTOR_ORIGIN=http://localhost:4666
